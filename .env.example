# Flight Pulse — environment variables (values only, never commit real secrets)

# Mapbox (public token, safe to expose client-side). Optional — falls back to a
# bundled SVG map when unset.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Canonical public URL, used for social metadata, sitemap.xml and robots.txt.
# Set this to your production domain (e.g. https://flight-pulse.example.com).
NEXT_PUBLIC_SITE_URL=

# LLM provider for the AI brief + Ask agent. "deepseek" (default) | "anthropic" | "openai"
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Optional model overrides:
# DEEPSEEK_MODEL=deepseek-chat
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# OPENAI_MODEL=gpt-4o-mini

# Optional: protect the LLM endpoints (ask/brief) behind a bearer token.
# ADMIN_API_KEY=

# Optional: hard ceiling on LLM invocations per month (default 20000). When
# reached, the AI layer degrades gracefully to deterministic text — no spend.
# LLM_MAX_MONTHLY_CALLS=20000

# MLflow tracking (optional). Logs agent + infra runs to this server (best-effort).
# MLFLOW_TRACKING_URI=http://localhost:5000

# Postgres connection string for durable budget counters (LLM calls, AviationStack
# requests). Optional — falls back to a local JSON file when unset. On Railway this
# is provided automatically by the Postgres plugin as DATABASE_URL.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# PG_SSL=true                            # enable SSL (recommended for managed Postgres)

# Flight performance data (AviationStack). Free tier ~100 requests/month.
AVIATIONSTACK_API_KEY=
# AVIATIONSTACK_CARRIERS=UA,AA,DL      # carriers ingested per run (default: 3)
# AVIATIONSTACK_TTL_MS=86400000        # cache TTL in ms (default: 24h daily ingest)
# AVIATIONSTACK_MAX_REQUESTS=90        # persistent monthly request budget
