# Flight Pulse — environment variables (values only, never commit real secrets)

# Mapbox (public token, safe to expose client-side). Optional — falls back to a
# bundled SVG map when unset.
NEXT_PUBLIC_MAPBOX_TOKEN=

# LLM provider for the AI brief + Ask agent. "deepseek" (default) | "anthropic" | "openai"
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Optional model overrides:
# DEEPSEEK_MODEL=deepseek-chat
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# OPENAI_MODEL=gpt-4o-mini

# Optional: protect the LLM endpoints (ask/brief) behind a bearer token.
# ADMIN_API_KEY=

# MLflow tracking (optional). Logs agent + infra runs to this server (best-effort).
# MLFLOW_TRACKING_URI=http://localhost:5000

# Flight performance data (AviationStack). Free tier ~100 requests/month.
AVIATIONSTACK_API_KEY=
# AVIATIONSTACK_CARRIERS=UA,AA,DL      # carriers ingested per run (default: 3)
# AVIATIONSTACK_TTL_MS=86400000        # cache TTL in ms (default: 24h daily ingest)
# AVIATIONSTACK_MAX_REQUESTS=90        # persistent monthly request budget
