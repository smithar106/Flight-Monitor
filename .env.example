# Flight Pulse — environment variables (values only, never commit real secrets)

# LLM provider for the AI Operations Brief + Ask Flight Pulse
# Uses the DeepSeek OpenAI-compatible chat-completions API.
DEEPSEEK_API_KEY=

# Optional: override the DeepSeek base URL / model.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# Optional: OpenSky Network credentials (anonymous access is the default and
# rate-limited; provide a free account to raise limits).
# OPENSKY_USERNAME=
# OPENSKY_PASSWORD=

# Optional: enable a verbose AI layer even when DEEPSEEK_API_KEY is missing is
# NOT supported — the brief/ask fall back to deterministic template text.
