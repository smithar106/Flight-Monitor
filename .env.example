# Flight Pulse — environment variables (values only, never commit real secrets)

# LLM provider for the AI Operations Brief + Ask Flight Pulse (DeepSeek,
# OpenAI-compatible chat-completions API).
DEEPSEEK_API_KEY=

# Optional: override the DeepSeek base URL / model.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# Live flight-status data (AviationStack). Free tier is ~100 requests/month.
AVIATIONSTACK_API_KEY=

# Optional live-data tuning (defaults are intentionally lean for the free tier):
# AVIATIONSTACK_CARRIERS=UA,AA,DL,WN   # carriers sampled per refresh (default: big four)
# AVIATIONSTACK_TTL_MS=86400000        # cache TTL in ms (default: 24h daily refresh)
# AVIATIONSTACK_MAX_REQUESTS=90        # persistent monthly request budget
