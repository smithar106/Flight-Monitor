# Flight Pulse — environment variables (values only, never commit real secrets)

# LLM provider for the AI Operations Brief + Ask Flight Pulse (DeepSeek,
# OpenAI-compatible chat-completions API).
DEEPSEEK_API_KEY=

# Optional: override the DeepSeek base URL / model.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# MLflow tracking (optional). When set, agent (brief/ask) and infra (data
# ingest) runs are logged to this MLflow server. Best-effort — never affects
# the app if unreachable.
# MLFLOW_TRACKING_URI=http://localhost:5000

# Flight performance data (AviationStack). Free tier is ~100 requests/month.
AVIATIONSTACK_API_KEY=

# Optional tuning (defaults are lean for the free tier):
# AVIATIONSTACK_CARRIERS=UA,AA,DL      # carriers ingested per run (default: 3)
# AVIATIONSTACK_TTL_MS=86400000        # cache TTL in ms (default: 24h daily ingest)
# AVIATIONSTACK_MAX_REQUESTS=90        # persistent monthly request budget
